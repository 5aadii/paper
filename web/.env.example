# Copy this file to .env.local and fill in real values. NEVER commit .env.local.
# Only NEXT_PUBLIC_* values reach the browser — the anon/publishable key is safe there.

# Supabase → Project Settings → API (or "API Keys")
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Where the Python engine runs (Render URL in production)
ENGINE_URL=http://localhost:8000

# Must be the SAME value as SERVICE_SHARED_SECRET in engine/.env
SERVICE_SHARED_SECRET=same-long-random-string-as-engine
