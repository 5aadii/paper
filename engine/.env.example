# Copy this file to .env and fill in real values. NEVER commit .env.
# These are server-only secrets: they must never reach the browser.

# Supabase → Project Settings → API (or "API Keys")
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# OpenRouter → Keys
OPENROUTER_API_KEY=sk-or-your-key-here
OPENROUTER_MODEL=provider/model-name

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Must be the SAME value as SERVICE_SHARED_SECRET in web/.env.local
SERVICE_SHARED_SECRET=long-random-string

# The web app's public URL (Vercel URL in production)
APP_PUBLIC_URL=http://localhost:3000
